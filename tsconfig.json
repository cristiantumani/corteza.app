{
  // Type checking for our JavaScript (no build step: tsc only checks, it doesn't emit).
  // Types come from JSDoc comments and the libraries' own types. Folders are added as they pass.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["es2022"],
    "types": ["node"],
    "strict": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  "include": ["src/types/**/*.d.ts", "src/core/**/*.js", "src/jobs/**/*.js", "src/ingestion/**/*.js", "src/http/**/*.js", "src/integrations/**/*.js", "src/auth/**/*.js", "src/middleware/**/*.js"]
}
