# Slack App Configuration (currently required to start; becomes optional in Phase 1)
# Either SLACK_BOT_TOKEN (single workspace) or SLACK_CLIENT_ID + SLACK_CLIENT_SECRET + SLACK_STATE_SECRET (OAuth)
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_CLIENT_ID=your-client-id
SLACK_CLIENT_SECRET=your-client-secret
SLACK_STATE_SECRET=random-64-hex-chars

# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/corteza?retryWrites=true&w=majority

# AI Service API Keys
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
# Optional: extraction model and output limit (defaults: claude-sonnet-5, 32000).
# Alternatives: claude-opus-5-5 (about 2x the cost per meeting), claude-haiku-4-5 (about half).
# Evaluate a model change first with: node scripts/eval-extraction.js
# CLAUDE_MODEL=claude-sonnet-5
# CLAUDE_MAX_TOKENS=32000
# Daily AI caps (core/usage/ai-usage.js): calls one person can trigger, and input+output tokens per workspace.
# Search answers, uploads and imports stop at the cap; automatic Meet capture is recorded but never blocked.
# AI_DAILY_CALLS_PER_USER=150
# AI_DAILY_TOKENS_PER_WORKSPACE=3000000
# How alike (cosine, 0-1) an action item from a colleague's meeting must be to one the owner already has to count as the same task (default 0.86)
# ACTION_DUPLICATE_SIMILARITY=0.86

# Cross-meeting links (docs/specs/2026-10-cross-meeting-links.md): a new outcome joins the thread of
# earlier meetings on the same subject and suggests closing what it resolves. Google domains,
# comma-separated, or "all"; empty = off. CROSS_MEETING_SIMILARITY: embedding pre-filter (cosine, default 0.45)
# CROSS_MEETING_LINKS_DOMAINS=ninjaexcel.com
# CROSS_MEETING_SIMILARITY=0.45
OPENAI_API_KEY=sk-your-openai-key

# Session and encryption (required)
SESSION_SECRET=your-session-secret-min-32-chars
# 64 hex chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-hex-char-encryption-key

# Optional: database name (default decision-logger)
# DB_NAME=decision-logger

# Server Configuration
PORT=3000
NODE_ENV=production

# PostHog product analytics (optional; off when unset). Events carry counts and ids only,
# never meeting content. POSTHOG_DISABLED=1 turns it off (the extraction eval does this).
# POSTHOG_PROJECT_TOKEN=phc_your-project-token
# POSTHOG_HOST=https://us.i.posthog.com

# Jira Integration (Optional; workspaces can also configure Jira in Settings)
JIRA_URL=https://your-company.atlassian.net
JIRA_EMAIL=you@your-company.com
JIRA_API_TOKEN=your-jira-api-token

# Google sign-in (required: it's the only way to log in)
# OAuth client of type "Web application" in Google Cloud; authorized redirect URI: ${BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Base URL of the app (used for OAuth redirect URIs, invites, digest and unsubscribe links)
BASE_URL=https://app.corteza.app

# Resend API key for all outgoing email (invites, feedback, weekly digest)
RESEND_API_KEY=re_your_resend_api_key

# Where new user feedback is emailed (optional; feedback is always stored in MongoDB)
FEEDBACK_EMAIL=you@example.com

# Private beta (optional). With BETA_REQUIRED=true, only approved people (beta_access) can create
# a new workspace; everyone else is sent to the early access form. Members, invites and colleagues
# joining their company's workspace are not affected.
BETA_REQUIRED=false
# Signs the "Approve" link in the website's early access email. Set the SAME value in the website's
# Lovable Cloud secrets. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETA_APPROVAL_SECRET=
# Where people without beta access go (default https://corteza.app/early-access)
# EARLY_ACCESS_URL=https://corteza.app/early-access
# Field encryption of meeting content (core/crypto, docs/specs/2026-10-workspace-encryption.md).
# DATA_KEK wraps each workspace's key: 64 hex chars, keep it out of the database and never change it
# without rewrapping (losing it makes encrypted data unreadable). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# FIELD_ENCRYPTION=on encrypts new writes (reads always handle both). STRICT makes filters on
# encrypted fields throw (tests, CI).
# DATA_KEK=
# FIELD_ENCRYPTION=on
# FIELD_ENCRYPTION_STRICT=false

# Sender of the beta welcome email (default: Cristian from Corteza <cristian@corteza.app>), so testers can reply.
# Other emails (digests, imports, invites) come from noreply@corteza.app.
# BETA_FROM=Your Name <you@example.com>
# Reply-to address of the beta welcome email (default: the sender above)
# BETA_REPLY_TO=you@example.com

# Settings → Context for the AI → "Add from Google Drive" (optional; the button shows only when both are set).
# Browser API key restricted to the Google Picker API and to ${BASE_URL}/*; the Cloud project number of the
# same project as GOOGLE_CLIENT_ID; and ${BASE_URL} as an authorized JavaScript origin of the OAuth client.
# Setup steps: docs/specs/2026-10-context-from-drive.md
# GOOGLE_PICKER_API_KEY=
# GOOGLE_CLOUD_PROJECT_NUMBER=

# Google Meet automatic capture (optional; on when GOOGLE_CLIENT_ID/SECRET are set)
# OAuth client also needs the redirect URI ${BASE_URL}/integrations/google/callback
# MEET_CAPTURE_ENABLED=false
# MEET_POLL_INTERVAL_MINUTES=5
# How many days back "Import past meetings" reaches (default 7 during the beta; max 92)
# MEET_IMPORT_MAX_DAYS=7
# Imports extract through the Message Batches API (half price, minutes to an hour); false = one at a time, live
# AI_BATCH_IMPORTS=true

# Daily digest: one morning email per person to plan the day (due today, overdue, to review; meetings,
# decisions and new action items since the last one). On whenever RESEND_API_KEY is set.
# Mon–Fri at DAILY_DIGEST_HOUR (default 8) in each person's time zone (detected by the browser or set in
# Settings); people without one get their workspace's most common zone, else DAILY_DIGEST_DEFAULT_TIMEZONE.
# DAILY_DIGEST_ENABLED=false
# DAILY_DIGEST_HOUR=8
# DAILY_DIGEST_DEFAULT_TIMEZONE=UTC
# Morning partner for people who haven't picked one in Settings: classic | sergeant | sarcastic (default sarcastic
# during the beta; see docs/specs/2026-10-morning-partner.md)
# DIGEST_DEFAULT_VOICE=sarcastic

# Weekly decision digest (optional). Sent Mondays at DIGEST_HOUR_UTC to members with an email.
WEEKLY_DIGEST_ENABLED=false
DIGEST_HOUR_UTC=9


