# Slack App Configuration (currently required to start; becomes optional in Phase 1)
# Either SLACK_BOT_TOKEN (single workspace) or SLACK_CLIENT_ID + SLACK_CLIENT_SECRET + SLACK_STATE_SECRET (OAuth)
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_CLIENT_ID=your-client-id
SLACK_CLIENT_SECRET=your-client-secret
SLACK_STATE_SECRET=random-64-hex-chars

# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/corteza?retryWrites=true&w=majority

# AI Service API Keys
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
# Optional: extraction model and output limit (defaults: claude-sonnet-5, 16000).
# Alternatives: claude-opus-5-5 (about 2x the cost per meeting), claude-haiku-4-5 (about half).
# Evaluate a model change first with: node scripts/eval-extraction.js
# CLAUDE_MODEL=claude-sonnet-5
# CLAUDE_MAX_TOKENS=16000
OPENAI_API_KEY=sk-your-openai-key

# Session and encryption (required)
SESSION_SECRET=your-session-secret-min-32-chars
# 64 hex chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-hex-char-encryption-key

# Optional: database name (default decision-logger)
# DB_NAME=decision-logger

# Server Configuration
PORT=3000
NODE_ENV=production

# PostHog analytics (optional in production; required in development to avoid silently missing events)
POSTHOG_PROJECT_TOKEN=phc_your-project-token
POSTHOG_HOST=https://us.i.posthog.com

# Jira Integration (Optional; workspaces can also configure Jira in Settings)
JIRA_URL=https://your-company.atlassian.net
JIRA_EMAIL=you@your-company.com
JIRA_API_TOKEN=your-jira-api-token

# AI Evaluation (Development/CI)
BRAINTRUST_API_KEY=your-braintrust-api-key
TEST_WORKSPACE_ID=your-test-workspace-id

# Google sign-in (required: it's the only way to log in)
# OAuth client of type "Web application" in Google Cloud; authorized redirect URI: ${BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Base URL of the app (used for OAuth redirect URIs, invites, digest and unsubscribe links)
BASE_URL=https://app.corteza.app

# Resend API key for all outgoing email (invites, feedback, weekly digest)
RESEND_API_KEY=re_your_resend_api_key

# Where new user feedback is emailed (optional; feedback is always stored in MongoDB)
FEEDBACK_EMAIL=you@example.com

# Private beta (optional). With BETA_REQUIRED=true, only approved people (beta_access) can create
# a new workspace; everyone else is sent to the early access form. Members, invites and colleagues
# joining their company's workspace are not affected.
BETA_REQUIRED=false
# Signs the "Approve" link in the website's early access email. Set the SAME value in the website's
# Lovable Cloud secrets. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETA_APPROVAL_SECRET=
# Where people without beta access go (default https://corteza.app/early-access)
# EARLY_ACCESS_URL=https://corteza.app/early-access
# Reply-to address of the beta welcome email (default: FEEDBACK_EMAIL)
# BETA_REPLY_TO=you@example.com

# Google Meet automatic capture (optional; on when GOOGLE_CLIENT_ID/SECRET are set)
# OAuth client also needs the redirect URI ${BASE_URL}/integrations/google/callback
# MEET_CAPTURE_ENABLED=false
# MEET_POLL_INTERVAL_MINUTES=5

# Weekly decision digest (optional). Sent Mondays at DIGEST_HOUR_UTC to members with an email.
WEEKLY_DIGEST_ENABLED=false
DIGEST_HOUR_UTC=9


