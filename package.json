{
  "name": "corteza",
  "version": "1.0.0",
  "description": "AI-powered decision tracking for Slack teams",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node src/index.js",
    "build:css": "NODE_ENV=production postcss src/styles/tailwind.input.css -o public/styles/tailwind.min.css",
    "test": "DOTENV_CONFIG_QUIET=true node --test test/unit/*.test.js test/integration/*.test.js",
    "eval": "node evals/run-evals.js",
    "eval:search": "node evals/run-search-evals.js",
    "eval:conversational": "node evals/run-conversational-evals.js",
    "eval:watch": "nodemon evals/run-evals.js",
    "lint": "eslint ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@slack/bolt": "^4.6.0",
    "connect-mongo": "^6.0.0",
    "dotenv": "^17.2.3",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.18.2",
    "google-auth-library": "^11.1.0",
    "mammoth": "^1.11.0",
    "mongodb": "^7.0.0",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^2.7.0",
    "openai": "^4.77.3",
    "pdf-parse": "^2.4.5",
    "resend": "^6.9.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.2.0",
    "@tailwindcss/forms": "^0.5.11",
    "autoprefixer": "^10.5.0",
    "braintrust": "^2.2.0",
    "cssnano": "^8.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "mongodb-memory-server": "^11.3.0",
    "postcss": "^8.5.15",
    "postcss-cli": "^11.0.1",
    "tailwindcss": "^3.4.19",
    "tailwindcss-cli": "^0.1.2"
  }
}
